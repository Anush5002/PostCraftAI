# PostCraft AI - Environment Configuration Template
# Duplicate this file to .env and provide your API keys

# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# AI Model Integrations
# Google Gemini (Gemini 2.5 Flash)
AI_INTEGRATIONS_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud (LLaMA 3.3 70B Versatile)
GROQ_API_KEY=your_groq_api_key_here

# NVIDIA NIM (Qwen 3 / Qwen 2.5)
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# Hugging Face Inference API (FLUX.1-schnell Image Generation)
HUGGINGFACE_API_KEY=your_huggingface_token_here

# Database Configuration (MongoDB)
# Default is mongodb://localhost:27017/PostCraft-AI
MONGODB_URI=mongodb://localhost:27017/PostCraft-AI

